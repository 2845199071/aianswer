<?xml version="1.0" encoding="utf-8"?>
<!--
  题库条目详情（v7.1）
  ─ 看题干、看来源、改答案（改完即锁定为金标准）
  ─ 有分歧时列出候选，人工采纳哪一方
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="题目详情"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemFlag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvItemQ"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:maxLines="10"
            android:textColor="@color/text_body"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvItemOpts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:maxLines="10"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:visibility="gone" />

        <View style="@style/DialogDivider" />

        <TextView
            style="@style/DialogSection"
            android:layout_marginTop="0dp"
            android:text="当前答案" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemAns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemSrc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnVerifyAns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/pill_soft"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="确认可用"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            style="@style/DialogSection"
            android:text="改成" />

        <LinearLayout
            android:id="@+id/boxLetters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/btnSaveAns"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="保存这个答案"
            android:textColor="@color/text_body"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="改完后这道题的答案会被锁定，模型以后给出不同答案也不会覆盖它"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <!-- 冲突区：有分歧才显示 -->
        <LinearLayout
            android:id="@+id/boxConflict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View style="@style/DialogDivider" />

            <TextView
                android:id="@+id/tvConflictTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="有不同答案"
                android:textColor="@color/warning"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="点「采纳」把某一方定为最终答案；采纳后同样会锁定"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/boxConflictList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <View style="@style/DialogDivider" />

        <TextView
            android:id="@+id/tvItemMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnWrongToggle"
                style="@style/GhostButton"
                android:text="标为错题" />

            <TextView
                android:id="@+id/btnDeleteItem"
                style="@style/GhostButton"
                android:layout_marginStart="8dp"
                android:text="删除此题"
                android:textColor="@color/danger" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseItem"
            style="@style/PrimaryButton"
            android:layout_marginTop="12dp"
            android:text="完成" />
    </LinearLayout>
</ScrollView>
