<?xml version="1.0" encoding="utf-8"?>
<!--
  自选题库（v7.2）
  ─ 支持 xlsx / csv / tsv / txt / docx / json，解析规则沿用刷题助手（已在 1201 题语料上验证）
  ─ 导入多份会合并检索，同题干不同版本自动合并答案
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="自选题库"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelfCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_bg"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:text="未导入"
            android:textColor="@color/text_hint"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="支持 Excel(.xlsx)、CSV/TSV、Word(.docx)、纯文本、JSON。\n导入多份会合并检索；命中后按选项文字定位屏幕答案，选项顺序被打乱也不会点错。"
        android:textColor="@color/text_hint"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/boxSelf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvSelfEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingTop="34dp"
                android:paddingBottom="34dp"
                android:text="还没有导入题库\n点下面的按钮选一个文件，解析结果会先给你看再入库"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnImport"
        style="@style/PrimaryButton"
        android:layout_marginTop="8dp"
        android:text="上传题库文件" />

    <Button
        android:id="@+id/btnCloseSelf"
        style="@style/SecondaryButton"
        android:layout_marginTop="8dp"
        android:text="完成" />
</LinearLayout>
